{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>meziantou/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "**/*.cs"
      ],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "new\\s+NuGetReference\\s*\\(\\s*\"(?<depName>[^\"]+)\"\\s*,\\s*\"(?<currentValue>[^\"]+)\"\\s*\\)"
      ],
      "datasourceTemplate": "nuget",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)tests/Meziantou\\.Sdk\\.Tests/Helpers/DotNetSdkHelpers\\.cs$/"
      ],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "private\\s+const\\s+string\\s+Net(?:10|11)SdkVersion\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "dotnet-sdk",
      "datasourceTemplate": "dotnet-version",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "dotnet-version"
      ],
      "matchFileNames": [
        "/(^|/)tests/Meziantou\\.Sdk\\.Tests/Helpers/DotNetSdkHelpers\\.cs$/"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
