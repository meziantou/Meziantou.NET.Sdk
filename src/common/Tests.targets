<Project>
  <!-- When running dotnet test, disable analyzers to compile faster and get feedback earlier -->
  <!-- This assume that most CI uses an actual dotnet build/publish/pack in parallel of dotnet test -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <EnableCodeCoverage Condition="'$(EnableCodeCoverage)' == '' AND '$(ContinuousIntegrationBuild)' == 'true'">true</EnableCodeCoverage>
    <EnableDefaultTestFramework Condition="'$(EnableDefaultTestFramework)' == ''">true</EnableDefaultTestFramework>
    <EnableGitHubActionsReport Condition="'$(EnableGitHubActionsReport)' == ''">true</EnableGitHubActionsReport>
    <MinimumExpectedTests Condition="'$(MinimumExpectedTests)' == ''">1</MinimumExpectedTests>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableDefaultTestFramework)' == 'true'">
    <!-- xUnit.net v3 test projects must be executables. 'Library' is the value set by Microsoft.NET.Sdk.props when the project doesn't set one -->
    <OutputType Condition="'$(OutputType)' == 'Library'">Exe</OutputType>

    <!-- Use the Microsoft Testing Platform command line instead of the xUnit.net console runner -->
    <UseMicrosoftTestingPlatformRunner Condition="'$(UseMicrosoftTestingPlatformRunner)' == ''">true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <Target Name="DisableAnalyzerWhenRunningTests" BeforeTargets="_MTPBuild" Condition="'$(OptimizeTestRun)' != 'false'">
    <PropertyGroup>
      <RunAnalyzers>false</RunAnalyzers>
    </PropertyGroup>
  </Target>

  <!-- Add the default test framework when the project doesn't reference one -->
  <!-- This item group must be evaluated before the ones detecting the test platform to use -->
  <ItemGroup Condition="'$(EnableDefaultTestFramework)' == 'true' AND
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit')) != 'true' AND
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit.v3')) != 'true' AND
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit.v3.mtp-v1')) != 'true' AND
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit.v3.mtp-v2')) != 'true' AND
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit.v3.mtp-off')) != 'true' AND
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit.v3.core')) != 'true' AND
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit.v3.core.mtp-v2')) != 'true' AND
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit.v3.core.mtp-off')) != 'true' AND
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'TUnit')) != 'true' AND
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'TUnit.Core')) != 'true' AND
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'MSTest')) != 'true' AND
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'MSTest.TestFramework')) != 'true' AND
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'NUnit')) != 'true'">
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0" IsImplicitlyDefined="true" />

    <!-- An item is used instead of a property as item lists cannot be referenced in a property condition outside of a target (MSB4099) -->
    <_DefaultTestFrameworkAdded Include="true" />
  </ItemGroup>

  <!-- Use 'Meziantou.Framework.Assertions' as the default assertion library -->
  <!-- The package only supports .NET 10 and later, so it is added by default only when the SDK adds the default
       test framework and the project targets a supported framework. Set 'EnableMeziantouAssertions' to 'true' to
       add it whatever the referenced packages and the target framework are, or to 'false' to never add it. -->
  <ItemGroup Condition="'$(EnableMeziantouAssertions)' == 'true' OR (
                        '$(EnableMeziantouAssertions)' == '' AND
                        '@(_DefaultTestFrameworkAdded)' == 'true' AND
                        $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))
                        )">
    <PackageReference Include="Meziantou.Framework.Assertions" Version="2.0.5" IsImplicitlyDefined="true" />

    <!-- 'Assert' must refer to 'Meziantou.Framework.Assertions.Assert', not to the one of the test framework.
         A using alias takes precedence over the namespaces imported in the same scope, so the alias wins over
         the global 'using Xunit;' directive. -->
    <Using Include="Meziantou.Framework.Assertions.Assert" Alias="Assert" />
  </ItemGroup>

  <!-- MTP is the only supported test platform, so the extensions are always added -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CrashDump" Version="2.3.3" IsImplicitlyDefined="true" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" IsImplicitlyDefined="true" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.3.3" IsImplicitlyDefined="true" />
    <PackageReference Include="Microsoft.Testing.Extensions.HotReload" Version="2.3.3" IsImplicitlyDefined="true" />
    <PackageReference Include="Microsoft.Testing.Extensions.Retry" Version="2.3.3" IsImplicitlyDefined="true" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.3.3" IsImplicitlyDefined="true" />
    <PackageReference Include="Microsoft.Testing.Extensions.GitHubActionsReport" Version="1.0.0-alpha.26377.5" IsImplicitlyDefined="true" Condition="'$(EnableGitHubActionsReport)' != 'false'" />
  </ItemGroup>

  <PropertyGroup Condition="'$(EnableDefaultTestSettings)' != 'false'">
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --report-trx</TestingPlatformCommandLineArguments>
    <!-- Slow-test notices are disabled as they are mostly noise on CI machines with varying performance -->
    <TestingPlatformCommandLineArguments Condition="'$(EnableGitHubActionsReport)' != 'false'">$(TestingPlatformCommandLineArguments) --report-gh --report-gh-slow-test-notices off</TestingPlatformCommandLineArguments>
    <TestingPlatformCommandLineArguments Condition="'$(EnableCodeCoverage)' == 'true'">$(TestingPlatformCommandLineArguments) --coverage</TestingPlatformCommandLineArguments>
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --crashdump --crashdump-type mini</TestingPlatformCommandLineArguments>
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --hangdump --hangdump-timeout 10m --hangdump-type mini</TestingPlatformCommandLineArguments>
    <!-- Microsoft.Testing.Platform only accepts a non-zero positive value, so the argument is not set when 'MinimumExpectedTests' is '0' -->
    <TestingPlatformCommandLineArguments Condition="'$(MinimumExpectedTests)' != '' AND '$(MinimumExpectedTests)' != '0'">$(TestingPlatformCommandLineArguments) --minimum-expected-tests $(MinimumExpectedTests)</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <!-- Generate a source file configuring the parallelization mode for xUnit.net v3 -->
  <!-- https://xunit.net/docs/running-tests-in-parallel#changing-default-behaviors -->
  <!-- 'Xunit.v3.ParallelizationAttribute' only exists in xunit.v3 4.0 and later, so the file is generated
       by default only when such a reference is resolved. Set 'EnableXunitFullParallelization' to 'true' to
       generate it whatever the resolved references are, or to 'false' to never generate it. -->
  <!-- 'XunitParallelizationMode' sets the generated mode ('None', 'Collections' or 'All'). Setting it also
       generates the file whatever the resolved references are, like 'EnableXunitFullParallelization=true'. -->
  <Target Name="GenerateXunitParallelizationSourceFile"
          BeforeTargets="BeforeCompile;CoreCompile"
          Condition="'$(EnableXunitFullParallelization)' != 'false' AND '$(Language)' == 'C#'">
    <Error Text="'XunitParallelizationMode' has an invalid value: '$(XunitParallelizationMode)'. Valid values are 'None', 'Collections' and 'All'."
           Condition="'$(XunitParallelizationMode)' != '' AND
                      '$(XunitParallelizationMode)' != 'None' AND
                      '$(XunitParallelizationMode)' != 'Collections' AND
                      '$(XunitParallelizationMode)' != 'All'" />

    <ItemGroup>
      <_XunitParallelizationCapableReference Include="@(ReferencePath)"
                                             Condition="'%(ReferencePath.NuGetPackageId)' == 'xunit.v3.extensibility.core' AND
                                                        '%(ReferencePath.NuGetPackageVersion)' != '' AND
                                                        $([MSBuild]::VersionGreaterThanOrEquals('%(ReferencePath.NuGetPackageVersion)', '4.0.0'))" />
    </ItemGroup>

    <PropertyGroup>
      <_GenerateXunitParallelizationSourceFile Condition="'$(EnableXunitFullParallelization)' == 'true' OR '$(XunitParallelizationMode)' != '' OR '@(_XunitParallelizationCapableReference)' != ''">true</_GenerateXunitParallelizationSourceFile>
      <_XunitParallelizationSourceFile>$(IntermediateOutputPath)Meziantou.NET.Sdk.XunitParallelization.g$(DefaultLanguageSourceExtension)</_XunitParallelizationSourceFile>

      <!-- MSBuild comparisons are case-insensitive, so the value is normalized to the casing of the enum members -->
      <_XunitParallelizationMode Condition="'$(XunitParallelizationMode)' == 'None'">None</_XunitParallelizationMode>
      <_XunitParallelizationMode Condition="'$(XunitParallelizationMode)' == 'Collections'">Collections</_XunitParallelizationMode>
      <_XunitParallelizationMode Condition="'$(_XunitParallelizationMode)' == ''">All</_XunitParallelizationMode>
    </PropertyGroup>

    <ItemGroup Condition="'$(_GenerateXunitParallelizationSourceFile)' == 'true'">
      <_XunitParallelizationSourceLine Include="// &lt;auto-generated /&gt;" />
      <_XunitParallelizationSourceLine Include="// Generated by Meziantou.NET.Sdk.Test. Set 'XunitParallelizationMode' to change the mode, or 'EnableXunitFullParallelization' to 'false' to opt out." />
      <_XunitParallelizationSourceLine Include="[assembly: Xunit.v3.Parallelization(Mode = Xunit.Sdk.ParallelMode.$(_XunitParallelizationMode))]" />
    </ItemGroup>

    <!-- The encoding must be explicit, so the file has a BOM. Otherwise, the compiler reports CS8055 when embedding sources in the PDB. -->
    <WriteLinesToFile File="$(_XunitParallelizationSourceFile)"
                      Lines="@(_XunitParallelizationSourceLine)"
                      Encoding="utf-8"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Condition="'$(_GenerateXunitParallelizationSourceFile)' == 'true'" />

    <ItemGroup Condition="'$(_GenerateXunitParallelizationSourceFile)' == 'true'">
      <Compile Include="$(_XunitParallelizationSourceFile)" />
      <FileWrites Include="$(_XunitParallelizationSourceFile)" />
    </ItemGroup>
  </Target>

  <!-- Generate a source file with static helpers simplifying the usage of the xUnit.net v3 test context -->
  <!-- 'Xunit.TestContext' only exists in xUnit.net v3, so the file is generated by default only when such a
       package is referenced. Set 'EnableXunitStaticHelpers' to 'true' to generate it whatever the referenced
       packages are, or to 'false' to never generate it. -->
  <!-- An item is used instead of a property as item lists cannot be referenced in a property condition outside of a target (MSB4099) -->
  <ItemGroup Condition="'$(EnableXunitStaticHelpers)' == '' AND (
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit.v3')) == 'true' OR
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit.v3.mtp-v1')) == 'true' OR
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit.v3.mtp-v2')) == 'true' OR
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit.v3.mtp-off')) == 'true' OR
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit.v3.core')) == 'true' OR
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit.v3.core.mtp-v2')) == 'true' OR
                        @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit.v3.core.mtp-off')) == 'true'
                        )">
    <_XunitStaticHelpersEnabled Include="true" />
  </ItemGroup>

  <!-- The members are usable without any using directive. Implicit usings are required as the global using
       directive is generated from the 'Using' items. -->
  <ItemGroup Condition="('$(EnableXunitStaticHelpers)' == 'true' OR '@(_XunitStaticHelpersEnabled)' == 'true') AND '$(ImplicitUsings)' == 'enable'">
    <Using Include="Meziantou.NET.Sdk.Test.XUnitStaticHelpers" Static="true" />
  </ItemGroup>

  <Target Name="GenerateXunitStaticHelpersSourceFile"
          BeforeTargets="BeforeCompile;CoreCompile"
          Condition="('$(EnableXunitStaticHelpers)' == 'true' OR '@(_XunitStaticHelpersEnabled)' == 'true') AND '$(Language)' == 'C#'">
    <PropertyGroup>
      <_XunitStaticHelpersSourceFile>$(IntermediateOutputPath)Meziantou.NET.Sdk.XunitStaticHelpers.g$(DefaultLanguageSourceExtension)</_XunitStaticHelpersSourceFile>
    </PropertyGroup>

    <ItemGroup>
      <_XunitStaticHelpersSourceLine Include="// &lt;auto-generated /&gt;" />
      <_XunitStaticHelpersSourceLine Include="// Generated by Meziantou.NET.Sdk.Test. Set 'EnableXunitStaticHelpers' to 'false' to opt out." />
      <_XunitStaticHelpersSourceLine Include="namespace Meziantou.NET.Sdk.Test%3B" />
      <_XunitStaticHelpersSourceLine Include="[global::System.CodeDom.Compiler.GeneratedCode(&quot;Meziantou.NET.Sdk.Test&quot;, null)]" />
      <_XunitStaticHelpersSourceLine Include="internal static partial class XUnitStaticHelpers" />
      <_XunitStaticHelpersSourceLine Include="{" />
      <_XunitStaticHelpersSourceLine Include="    /// &lt;summary&gt;Gets the cancellation token of the test being executed.&lt;/summary&gt;" />
      <_XunitStaticHelpersSourceLine Include="    public static global::System.Threading.CancellationToken XunitCancellationToken =&gt; global::Xunit.TestContext.Current.CancellationToken%3B" />
      <_XunitStaticHelpersSourceLine Include="}" />
    </ItemGroup>

    <!-- The encoding must be explicit, so the file has a BOM. Otherwise, the compiler reports CS8055 when embedding sources in the PDB. -->
    <WriteLinesToFile File="$(_XunitStaticHelpersSourceFile)"
                      Lines="@(_XunitStaticHelpersSourceLine)"
                      Encoding="utf-8"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(_XunitStaticHelpersSourceFile)" />
      <FileWrites Include="$(_XunitStaticHelpersSourceFile)" />
    </ItemGroup>
  </Target>

  <!-- Define the 'XUNIT_ENTRYPOINT_DISABLE_WARNINGS' compilation constant. Set 'EnableXunitEntryPointDisableWarnings' to 'false' to opt out. -->
  <!-- Visual Basic separates the constants with ',' and requires a value for each of them, otherwise the compiler reports BC31030 -->
  <PropertyGroup Condition="'$(EnableXunitEntryPointDisableWarnings)' != 'false'">
    <DefineConstants Condition="'$(MSBuildProjectExtension)' == '.vbproj'">$(DefineConstants),XUNIT_ENTRYPOINT_DISABLE_WARNINGS=-1</DefineConstants>
    <DefineConstants Condition="'$(MSBuildProjectExtension)' != '.vbproj'">$(DefineConstants);XUNIT_ENTRYPOINT_DISABLE_WARNINGS</DefineConstants>
  </PropertyGroup>

  <!-- Add implicit using for xunit -->
  <ItemGroup Condition="'$(ImplicitUsings)' == 'enable' AND (
                            @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit')) == 'true' OR
                            @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit.v3')) == 'true' OR
                            @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit.v3.mtp-v1')) == 'true' OR
                            @(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'xunit.v3.mtp-v2')) == 'true'
                            )">
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
